generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ============================
 * ENUMS — ASSESSMENT PLATFORM (existing, unchanged)
 * ============================
 */

enum UserRole {
  admin
  moderator
  candidate
  recruiter   // interview portal
  interviewer // interview portal
}

enum SessionStatus {
  upcoming
  active
  completed
}

enum QuestionCategory {
  aptitude
  technical
}

enum QuestionType {
  single_select
  multi_select
}

enum QuestionDifficulty {
  easy
  medium
  hard
}

enum SectionType {
  aptitude
  technical
}

enum MonitoringEventType {
  tab_switch
  screenshot
  blur
  focus
}

/**
 * ============================
 * ENUMS — INTERVIEW PORTAL (new)
 * ============================
 */

enum CandidateStatus {
  added
  interview_scheduled
  interview_done
  next_round
  on_hold
  rejected
  hired
}

enum InterviewSessionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum InterviewQuestionType {
  mcq_single
  mcq_multi
  subjective
  coding
}

enum InterviewQuestionSource {
  ai_generated
  manual
}

enum InterviewRecommendation {
  strong_hire
  hire
  no_hire
  strong_no_hire
}

enum HiringDecisionType {
  next_round
  on_hold
  rejected
  hired
}

/**
 * ============================
 * CORE TABLES — ASSESSMENT PLATFORM
 * ============================
 */

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String?
  role             UserRole
  firstName        String?
  lastName         String?
  collegeSessionId String?
  isActive         Boolean  @default(true)

  // interview portal invite chain
  invitedBy String?
  invitedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // assessment platform relations (unchanged)
  recruitmentSessions RecruitmentSession[] @relation("SessionCreator")
  exams               Exam[]               @relation("ExamCreator")
  questionsCreated    Question[]
  bulkUploads         BulkUpload[]

  // self-referential invite chain
  inviter  User?  @relation("UserInvites", fields: [invitedBy], references: [id])
  invitees User[] @relation("UserInvites")

  // interview portal relations
  candidatesAdded         Candidate[]        @relation("CandidateAddedBy")
  conductedSessions       InterviewSession[] @relation("SessionInterviewer")
  scheduledSessions       InterviewSession[] @relation("SessionScheduledBy")
  sessionQuestionsCreated SessionQuestion[]  @relation("SessionQuestionCreator")
  sessionFeedbacks        SessionFeedback[]  @relation("SessionFeedbackInterviewer")
  hiringDecisions         HiringDecision[]   @relation("HiringDecisionBy")

  @@index([role])
  @@index([collegeSessionId])
  @@index([invitedBy])
}

model College {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  recruitmentSessions RecruitmentSession[]
}

model RecruitmentSession {
  id        String        @id @default(uuid())
  name      String
  year      Int
  startDate DateTime?
  endDate   DateTime?
  status    SessionStatus

  collegeId String?
  createdBy String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  college College?   @relation(fields: [collegeId], references: [id])
  creator User       @relation("SessionCreator", fields: [createdBy], references: [id])

  exams       Exam[]
  bulkUploads BulkUpload[]

  @@index([collegeId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
}

model Exam {
  id                  String    @id @default(uuid())
  title               String
  description         String?
  windowStartsAt      DateTime?
  windowEndsAt        DateTime?
  durationSeconds     Int
  isPublished         Boolean   @default(false)
  masterPasswordHash  String
  masterPasswordPlain String?

  collegeSessionId String?
  createdBy        String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  session     RecruitmentSession? @relation(fields: [collegeSessionId], references: [id])
  creator     User                @relation("ExamCreator", fields: [createdBy], references: [id])
  examSets    ExamSet[]
  submissions Submission[]

  @@index([collegeSessionId])
  @@index([isPublished])
}

model Question {
  id         String             @id @default(uuid())
  category   QuestionCategory
  stem       String
  type       QuestionType
  points     Int                @default(1)
  difficulty QuestionDifficulty @default(medium)

  createdBy String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  creator          User              @relation(fields: [createdBy], references: [id])
  options          QuestionOption[]
  examSetQuestions ExamSetQuestion[]
}

model QuestionOption {
  id         String  @id @default(uuid())
  optionText String
  isCorrect  Boolean @default(false)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamSet {
  id        String   @id @default(uuid())
  name      String
  examId    String
  createdAt DateTime @default(now())

  exam     Exam             @relation(fields: [examId], references: [id])
  sections ExamSetSection[]

  @@index([examId])
}

model ExamSetSection {
  id            String      @id @default(uuid())
  sectionType   SectionType
  questionCount Int

  examSetId String
  examSet   ExamSet @relation(fields: [examSetId], references: [id])

  questions ExamSetQuestion[]
}

model ExamSetQuestion {
  id               String @id @default(uuid())
  examSetSectionId String
  questionId       String

  section  ExamSetSection @relation(fields: [examSetSectionId], references: [id])
  question Question       @relation(fields: [questionId], references: [id])
}

model BulkUpload {
  id           String  @id @default(uuid())
  fileUrl      String
  errorCsvUrl  String?
  totalRows    Int
  successCount Int
  failedCount  Int

  uploadedBy       String
  collegeSessionId String

  createdAt DateTime @default(now())

  uploader User               @relation(fields: [uploadedBy], references: [id])
  session  RecruitmentSession @relation(fields: [collegeSessionId], references: [id])
}

/**
 * ============================
 * RUNTIME / HISTORICAL TABLES — ASSESSMENT PLATFORM
 * ============================
 */

model Submission {
  id        String @id @default(uuid())
  examId    String
  userId    String
  examSetId String

  startedAt     DateTime?
  submittedAt   DateTime?
  autoSubmitted Boolean   @default(false)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  exam        Exam              @relation(fields: [examId], references: [id])
  scores      SubmissionScore[]
  monitoring  MonitoringEvent[]
  finalResult FinalResult?

  @@index([examId])
  @@index([userId])
  @@index([submittedAt])
}

model SubmissionScore {
  id            String    @id @default(uuid())
  submissionId  String
  questionId    String
  marksObtained Float
  answeredAt    DateTime?

  submission Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  answers    SubmissionAnswer[]

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model SubmissionAnswer {
  id                String @id @default(uuid())
  submissionScoreId String
  selectedOptionId  String

  submissionScore SubmissionScore @relation(fields: [submissionScoreId], references: [id], onDelete: Cascade)

  @@index([submissionScoreId])
}

model MonitoringEvent {
  id           String              @id @default(uuid())
  submissionId String
  eventType    MonitoringEventType
  eventCount   Int
  createdAt    DateTime            @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model FinalResult {
  id                   String  @id @default(uuid())
  submissionId         String  @unique
  totalMarks           Float
  aptitudeMarks        Float
  technicalMarks       Float
  tabSwitchCount       Int
  screenshotTaken      Boolean @default(false)
  kicked               Boolean @default(false)
  selectedForNextRound Boolean @default(false)
  rank                 Int?

  createdAt DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([rank])
  @@index([selectedForNextRound])
  @@index([submissionId, rank])
}

/**
 * ============================
 * INTERVIEW PORTAL TABLES (new)
 * ============================
 */

model Candidate {
  id                String          @id @default(uuid())
  name              String
  email             String          @unique
  phone             String?
  roleApplyingFor   String
  yearsOfExperience Int?
  skills            Json            @default("[]")
  education         Json            @default("[]")
  resumeUrl         String?
  referredBy        String?
  status            CandidateStatus @default(added)

  addedBy String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  adder            User               @relation("CandidateAddedBy", fields: [addedBy], references: [id])
  interviewSessions InterviewSession[]
  hiringDecisions   HiringDecision[]   @relation("HiringDecisionCandidate")

  @@index([status])
  @@index([addedBy])
  @@index([email])
}

model MeetingRoom {
  id            String   @id @default(uuid())
  name          String
  resourceEmail String   @unique
  location      String?
  capacity      Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  interviewSessions InterviewSession[]

  @@index([isActive])
}

model InterviewSession {
  id                   String                 @id @default(uuid())
  candidateId          String
  interviewerId        String
  scheduledById        String
  roomId               String?
  scheduledAt          DateTime
  durationMinutes      Int                    @default(60)
  meetLink             String?
  googleCalendarEventId String?
  status               InterviewSessionStatus @default(scheduled)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate   Candidate    @relation(fields: [candidateId], references: [id])
  interviewer User         @relation("SessionInterviewer", fields: [interviewerId], references: [id])
  scheduledBy User         @relation("SessionScheduledBy", fields: [scheduledById], references: [id])
  room        MeetingRoom? @relation(fields: [roomId], references: [id])

  questions SessionQuestion[]
  link      SessionLink?
  note      SessionNote?
  feedback  SessionFeedback?

  @@index([candidateId])
  @@index([interviewerId])
  @@index([scheduledById])
  @@index([status])
  @@index([scheduledAt])
}

model SessionQuestion {
  id            String                  @id @default(uuid())
  sessionId     String
  prompt        String
  type          InterviewQuestionType
  difficulty    QuestionDifficulty      @default(medium)
  tags          Json                    @default("[]")
  options       Json?
  exampleInput  String?
  exampleOutput String?
  source        InterviewQuestionSource @default(manual)
  order         Int                     @default(0)

  createdBy String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  creator User             @relation("SessionQuestionCreator", fields: [createdBy], references: [id])

  @@index([sessionId])
  @@index([order])
}

model SessionLink {
  id        String   @id @default(uuid())
  sessionId String   @unique
  token     String   @unique @default(uuid())
  expiresAt DateTime
  sentAt    DateTime?
  openedAt  DateTime?
  isExpired Boolean  @default(false)
  createdAt DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([token])
}

model SessionNote {
  id        String   @id @default(uuid())
  sessionId String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SessionFeedback {
  id                    String                  @id @default(uuid())
  sessionId             String                  @unique
  interviewerId         String
  problemSolvingRating  Int
  codeQualityRating     Int
  communicationRating   Int
  systemDesignRating    Int
  recommendation        InterviewRecommendation
  notes                 String?
  submittedAt           DateTime                @default(now())
  createdAt             DateTime                @default(now())

  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  interviewer User             @relation("SessionFeedbackInterviewer", fields: [interviewerId], references: [id])

  @@index([interviewerId])
}

model HiringDecision {
  id          String             @id @default(uuid())
  candidateId String
  decidedBy   String
  decision    HiringDecisionType
  notes       String?
  decidedAt   DateTime           @default(now())

  candidate Candidate @relation("HiringDecisionCandidate", fields: [candidateId], references: [id])
  decider   User      @relation("HiringDecisionBy", fields: [decidedBy], references: [id])

  @@index([candidateId])
  @@index([decidedBy])
}

// Single-row credential for the dedicated "calendar bot" Google account used
// to create interview events. `id` is always the fixed value "default".
model CalendarCredential {
  id           String   @id @default("default")
  refreshToken String
  updatedAt    DateTime @updatedAt
}

// Per-interviewer credential (calendar.freebusy scope only) so scheduling can
// check an interviewer's REAL Google Calendar availability, not just sessions
// booked through this app. `userId` is the interviewer's own User.id — no
// formal Prisma relation, mirroring CalendarCredential's minimal footprint.
model InterviewerCalendarCredential {
  userId       String   @id
  refreshToken String
  updatedAt    DateTime @updatedAt
}
